# ==============================================================================
# KUCOIN AL-SAT BOTU - ÖRNEK ÇEVRE DEĞİŞKENLERİ VE YAPILANDIRMA DOSYASI
# ==============================================================================
# Bu dosya botun çalışması için gerekli tüm yapılandırma ayarlarını içerir.
# Kullanım: Bu dosyayı '.env' adıyla kopyalayın ve kendi değerlerinizi girin:
#   cp .env.example .env
#
# DİKKAT: '.env' dosyası özel şifrelerinizi içerir. Kesinlikle Git veya
# harici bir depoya yüklemeyiniz! (.gitignore tarafından korunmaktadır)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KUCOIN API KİMLİK BİLGİLERİ (KuCoin API Credentials)
# ------------------------------------------------------------------------------
# KuCoin web sitesinden (API Management) oluşturduğunuz API anahtarlarıdır.
# Güvenlik Tavsiyesi: API oluştururken 'General' ve 'Trade' izinlerini açın,
# ancak 'Transfer' ve 'Withdrawal' (Para Çekme) izinlerini KAPALI tutun.

# KuCoin API Anahtarı (API Key - 24/32 karakterlik metin)
KUCOIN_API_KEY=your_kucoin_api_key_here

# KuCoin API Gizli Anahtarı (API Secret - Şifrelenmiş metin)
KUCOIN_API_SECRET=your_kucoin_api_secret_here

# KuCoin API Parolası (Passphrase - API oluştururken belirlediğiniz özel parola)
KUCOIN_API_PASSPHRASE=your_kucoin_api_passphrase_here


# ------------------------------------------------------------------------------
# 2. ÇALIŞMA VE TİCARET MODU AYARLARI (Trading & Environment Mode)
# ------------------------------------------------------------------------------

# KuCoin Resmi Sandbox (Testnet) Ortamı
# Açıklama: KuCoin'in resmi sandbox simülasyon ortamını mı yoksa gerçek borsayı mı kullanacağınızı belirler.
# Seçenekler:
#   - false : Gerçek KuCoin canlı borsasına bağlanır (Önerilen varsayılan).
#   - true  : KuCoin sandbox.kucoin.com testnet ortamına bağlanır (Sandbox API Key gerektirir).
KUCOIN_IS_SANDBOX=false

# Botun Varsayılan Başlangıç İşlem Modu
# Açıklama: Bot ilk başladığında sanal parayla mı yoksa gerçek bakiyeyle mi işlem yapacağını belirler.
# Seçenekler:
#   - paper : Sanal İşlem / Simülasyon modu. Gerçek bakiyenize dokunmaz, $10,000 sanal USDT ile test eder.
#   - live  : Canlı İşlem modu. Gerçek KuCoin hesabınızdan al-sat emirleri iletir.
# Varsayılan: paper (Güvenlik gereği varsayılan test modudur)
DEFAULT_TRADING_MODE=paper

# Simülasyon (Paper Trading) Sanal Başlangıç Bakiyesi
# Açıklama: 'paper' modunda kullanıcının sahip olacağı başlangıç sanal USDT miktarıdır.
# Varsayılan: 10000.0 (USDT)
SIMULATION_INITIAL_BALANCE_USDT=10000.0


# ------------------------------------------------------------------------------
# 3. SUNUCU VE REST API AYARLARI (Server & REST API Settings)
# ------------------------------------------------------------------------------

# Sunucu Ağ Dinleme Adresi (Host)
# Açıklama: FastAPI sunucusunun dinleyeceği ağ adresi.
# Seçenekler:
#   - 127.0.0.1 : Sadece yerel bilgisayarınızdan erişilebilir (En güvenli seçenek).
#   - 0.0.0.0   : Yerel ağdaki (Wi-Fi vb.) diğer cihazlardan ve harici IP'den erişime izin verir.
# Varsayılan: 127.0.0.1
HOST=127.0.0.1

# Sunucu Port Numarası
# Açıklama: Web Dashboard ve Swagger UI dokümantasyonuna erişeceğiniz port numarasıdır.
# Seçenekler: 1024 ile 65535 arası boş bir port (Örn: 8000, 8080, 5000)
# Varsayılan: 8000 (Erişim: http://127.0.0.1:8000/docs)
PORT=8000


# ------------------------------------------------------------------------------
# 4. GÜNLÜK VE LOGLAMA AYARLARI (Logging Settings)
# ------------------------------------------------------------------------------

# Konsol ve Dosya Log Detay Seviyesi
# Açıklama: Uygulama çalışırken terminale ve log dosyasına yazılacak logların detay seviyesidir.
# Seçenekler:
#   - DEBUG    : En kapsamlı mod; ağ istekleri, ham veriler ve tüm ayrıntıları içerir.
#   - INFO     : Standart mod; emirler, bakiye güncellemeleri ve önemli sistem olayları loglanır (Önerilen).
#   - WARNING  : Sadece olası sorunlar, gecikmeler ve uyarılar loglanır.
#   - ERROR    : Sadece hata durumları ve başarısız istekler loglanır.
#   - CRITICAL : Sadece sistemi durduran kritik felaket hataları loglanır.
# Varsayılan: INFO
LOG_LEVEL=INFO

# Dosyaya Log Kaydı (Log to File)
# Açıklama: Logların 'logs/app.log' dosyasına diske kaydedilip edilmeyeceğini belirler.
# Seçenekler:
#   - true  : Loglar diske kaydedilir ve geçmiş geriye dönük incelenebilir.
#   - false : Loglar sadece terminal konsolunda gösterilir, diske yazılmaz.
# Varsayılan: true
LOG_TO_FILE=true


# ------------------------------------------------------------------------------
# 5. VARSAYILAN PİYASA VE İŞLEM PARAMETRELERİ (Default Market Settings)
# ------------------------------------------------------------------------------

# Varsayılan Kripto İşlem Çifti (Symbol)
# Açıklama: Bot açıldığında takip edilecek ve analiz edilecek varsayılan paritedir.
# Seçenekler: KuCoin üzerinde işlem gören tüm USDT pariteleri (Örn: BTC-USDT, ETH-USDT, KCS-USDT, SOL-USDT)
# Varsayılan: BTC-USDT
DEFAULT_SYMBOL=BTC-USDT

# Varsayılan Mum / Zaman Dilimi (Timeframe)
# Açıklama: Analiz motorunun ve grafiklerin kullanacağı mum periyodudur.
# Seçenekler:
#   - 1m  : 1 Dakikalık mumlar (Çok hızlı sinyaller, yüksek gürültü)
#   - 5m  : 5 Dakikalık mumlar (Kısa vadeli scalping)
#   - 15m : 15 Dakikalık mumlar (Standart gün içi işlem periyodu - Önerilen)
#   - 1h  : 1 Saatlik mumlar (Orta vadeli trend takibi)
#   - 4h  : 4 Saatlik mumlar (Güçlü trend takibi)
#   - 1d  : Günlük mumlar (Uzun vadeli analiz)
# Varsayılan: 15m
DEFAULT_TIMEFRAME=15m
